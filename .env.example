# ── Sources & storage ─────────────────────────────
source_config_path=sources/ph_law_sources.yaml
db_path=data/sqlite/ph-law-rag.db
raw_data_dir=data/raw
normalized_data_dir=data/normalized
bm25_path=data/bm25

# ── Fetching ──────────────────────────────────────
request_timeout=30

# ── Qdrant (dense vectors) ────────────────────────
qdrant_collection=ph_law
qdrant_url=http://localhost:6333
# empty for local Qdrant; set for Qdrant Cloud
qdrant_api_key=

# ── Chunking ──────────────────────────────────────
chunk_size=256
chunk_overlap=32

# ── Embeddings ────────────────────────────────────
# embedding_backend selects default model/dim:
# ollama -> nomic-embed-text / 768
# bedrock -> amazon.titan-embed-text-v2:0 / 1024
embedding_backend=ollama
# Optional custom overrides; set both together for non-default models.
# embedding_model=
# embedding_dim=
ollama_base_url=http://localhost:11434

# ── Retrieval ─────────────────────────────────────
dense_top_k=30
sparse_top_k=10
sparse_overfetch_k=100
rerank_top_n=8
rerank_score_margin=6.0
max_distance=0.5
parent_expansion_enabled=true
parent_expansion_min_children=2
parent_expansion_max_chars=8000
prefer_operative_enabled=false
provision_supersession_path=sources/provision_supersession.yaml
# Provision-level operability overrides (whole-provision repeal/reclassification). Applied at
# index time; edits require `raglab reindex`. See sources/provision_status.yaml.
provision_status_path=sources/provision_status.yaml
min_chunks_for_answer=1
reranker_model=cross-encoder/ms-marco-MiniLM-L-6-v2
# qwen3 = eval-quality default (host, MPS). Serving surfaces (compose, Fargate)
# pin reranker_backend=minilm — qwen3 is not viable without a GPU. See ADR-016.
reranker_backend=qwen3
qwen3_reranker_model=Qwen/Qwen3-Reranker-0.6B
consolidated_dedup_enabled=true
retrieval_operative_only=true
edge_expansion_enabled=true
edge_hop_top_k=3

# ── Query planning / decomposition (experimental, off) ─
query_decomposition_enabled=false
query_planner_model=mistral
query_planner_max_subqueries=3
subquery_packaging_enabled=false
subquery_reserve_n=2

# ── Conversation memory ───────────────────────────
max_conversation_turns=5
enable_query_rewriting=true

# ── Answerability gate ────────────────────────────
answerability_gate_enabled=false
answerability_gate_model=mistral

# ── Generation (Ollama) ───────────────────────────
llm_model=mistral
# optional 2nd-pass groundedness audit
faithfulness_selfcheck_enabled=false
# extra prompt rule: later-enacted text wins on conflicts; A/B flag, off by default
later_enacted_preference_enabled=false

# ── Debug ─────────────────────────────────────────
debug=false

# ── Observability ─────────────────────────────────
log_dir=data/logs
log_level=INFO
log_to_file=true
log_max_bytes=10000000
log_backup_count=5
trace_logging_enabled=true
trace_max_text_preview=200

# ── API / UI ──────────────────────────────────────
api_base_url=http://localhost:8000
api_request_timeout=600

# ── Evals (RAGAS) ─────────────────────────────────
eval_dataset_path=data/eval_dataset.jsonl
eval_results_dir=data/eval_results
# optional A/B tag baked into output filenames
eval_run_label=
ragas_score_cache_path=data/eval_results/ragas_score_cache.sqlite
ragas_llm_model=claude-haiku-4-5-20251001
ragas_embedding_model=nomic-embed-text

# ── AWS (Bedrock embeddings) ──────────────────────
aws_region=us-east-1

# ── Secrets ───────────────────────────────────────
anthropic_api_key=
