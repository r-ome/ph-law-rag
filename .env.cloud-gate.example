# Cloud gate profile.
# Use with:
#   aws sso login --profile ph-law-rag-dev
#   export AWS_PROFILE=ph-law-rag-dev
#   RAGLAB_ENV_FILE=.env.cloud-gate raglab show-config
#   RAGLAB_ENV_FILE=.env.cloud-gate raglab reindex

# Embeddings: model/dim are derived from this backend.
embedding_backend=bedrock

# Bedrock
aws_region=us-east-1

# Qdrant Cloud
qdrant_url=https://YOUR_QDRANT_CLUSTER_URL
qdrant_api_key=YOUR_QDRANT_API_KEY
qdrant_collection=ph_law-titan1024

# Generation
llm_model=claude-haiku-4-5
anthropic_api_key=YOUR_ANTHROPIC_API_KEY

# Disable local-model side paths for the zero-Ollama gate.
enable_query_rewriting=false
answerability_gate_enabled=false
faithfulness_selfcheck_enabled=false
query_decomposition_enabled=false
